.container
  max-width: var(--content-width)
  margin: 0 auto
  padding: 20px

h1
  font-size: 2.5rem
  text-shadow: -4px 4px 1px var(--color-text-shadow)

#search
  display: flex
  align-items: center
  background-color: var(--color-grey-light)
  border-radius: 10px
  margin-top: 20px
  padding: 4px 10px
  box-shadow: var(--box-shadow)
  cursor: text

  svg
    width: 32px
    height: 32px
    padding: 0 4px
    fill: var(--color-text-white)
    flex-shrink: 0

  input
    border: none
    outline: none
    background-color: transparent
    height: 40px
    width: 100%
    font-size: 1.2rem
    padding: 0

    &::placeholder
      color: var(--color-grey-light)
      filter: brightness(2)

#features
  display: flex
  flex-direction: column
  padding-top: 8px

#no-results
  text-align: center
  padding: 40px 0
  font-size: 1.4rem
  opacity: .75

.feature-category > h2
  font-size: 1.8rem
  margin: 24px 0 12px
  text-shadow: -3px 3px 1px var(--color-text-shadow)

.feature-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))
  gap: 16px

.feature
  background-color: var(--color-grey-light)
  box-shadow: var(--box-shadow)
  padding: 16px
  color: var(--color-text-white)
  text-decoration: none
  border-radius: 10px
  user-select: none
  display: flex
  flex-direction: column
  gap: 10px
  border: 2px solid transparent
  transition: border-color .15s, transform .15s

  &:hover
    border-color: var(--color-blue)
    transform: translateY(-3px)

.feature-top
  display: flex
  align-items: center
  gap: 12px

  img
    width: 28px
    height: 28px
    background-color: var(--color-grey)
    border-radius: 10px
    padding: 6px

    &.plain
      width: 40px
      height: 40px
      padding: 0

.title
  font-size: 1.4rem
  font-weight: 700
  text-shadow: -2px 2px 1px var(--color-text-shadow)

.text
  line-height: 1.35
  opacity: .85